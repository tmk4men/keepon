<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ツヅキン"
        android:textColor="#3f7d6e"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/widget_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今日のメニュー"
        android:textColor="#2c2a26"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <Chronometer
        android:id="@+id/widget_chrono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3f7d6e"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_status_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今日は記録ずみ。お疲れさま！"
        android:textColor="#3f7d6e"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/widget_btn_start"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="開始"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_primary" />

        <Button
            android:id="@+id/widget_btn_stop"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="完了して記録"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
